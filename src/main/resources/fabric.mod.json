{
	"schemaVersion": 1,
	"id": "better_with_discord",
	"version": "${version}",
	"name": "Better With Discord",
	"description": "Links the chat of a Better Than Adventure server with a Discord channel.",
	"authors": [
		"SajmonOriginal"
	],
	"contact": {
		"sources": "https://github.com/MinecraftLabs/better-with-discord",
		"issues": "https://github.com/MinecraftLabs/better-with-discord/issues"
	},
	"license": "See LICENSE",
	"environment": "server",
	"entrypoints": {
		"server": [
			"com.sajmonoriginal.betterwithdiscord.BetterWithDiscordMod"
		]
	},
	"mixins": [
		"better_with_discord.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"halplibe": ">=${halplibe}",
		"minecraft": "~8.0.1",
		"java": ">=${java}"
	},
	"suggests": {
		"aether": "*",
		"betterwithbags": "*",
		"better_with_hands": "*"
	}
}
